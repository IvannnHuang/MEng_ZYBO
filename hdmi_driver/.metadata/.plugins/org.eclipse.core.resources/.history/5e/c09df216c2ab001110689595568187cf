// FPGA Solver Interface
void SolverInitialize(void);
void ReadSolverOutput(int *x, int *y, int *z);
int FloatToFixed(float val);
float FixedToFloat(int val);

// Graphics and framebuffer
void PlotLorenzAttractor(u8 *frame, u32 width, u32 height, u32 stride);
void ClearFramebuffer(u8 *frame, u32 width, u32 height, u32 stride);
void PlotPixel(u8 *frame, u32 x, u32 y, u32 width, u32 stride, u16 color);

// Utility functions
void ConvertSolverToScreen(int solver_x, int solver_y, int solver_z,
                          int *screen_x, int *screen_y,
                          u32 width, u32 height, int projection_mode);
float ReadFloatFromUART(void);
void PrintSolverStatus(void);

