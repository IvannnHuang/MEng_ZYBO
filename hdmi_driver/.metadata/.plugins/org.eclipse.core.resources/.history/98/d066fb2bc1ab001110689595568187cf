// Display and Video Driver structs
DisplayCtrl dispCtrl;
XAxiVdma vdma;
INTC intc;

// Framebuffers for video data
u8 frameBuf[DISPLAY_NUM_FRAMES][DEMO_MAX_FRAME] __attribute__((aligned(0x20)));
u8 *pFrames[DISPLAY_NUM_FRAMES]; //array of pointers to the frame buffers

// Solver state variables
struct {
    float sigma;
    float beta;
    float rho;
    int solver_enabled;
    int trace_mode;
    /*
     * Possible values:
	 *   0 = 2D view (X-Y plane)
	 *   1 = X-Z plane
	 *   2 = Y-Z plane
	 *   3 = 3D isometric projection
     */
} lorenz_config = {10.0, 8.33, 28.0, 0, 0};


/* ------------------------------------------------------------ */
/*				Procedure Definitions							*/
/* ------------------------------------------------------------ */

int main(void)
{
	DriverInitialize();
	DriverRun();
	return 0;
}

void DriverInitialize()
{
	int Status;                          // Stores return codes from API functions
	XAxiVdma_Config *vdmaConfig;         // Pointer to VDMA hardware configuration
	int i;                               // Loop counter

	// Array of pointers to the 3 frame buffers
	// (display reading, video writing, graphics rendering)
	for (i = 0; i < DISPLAY_NUM_FRAMES; i++)
	{
		pFrames[i] = frameBuf[i];
	}

	// Timer for simple delay
	TimerInitialize(SCU_TIMER_ID);

	// VDMA driver lookup and initialize
	vdmaConfig = XAxiVdma_LookupConfig(VDMA_ID);
	if (!vdmaConfig)
	{
		xil_printf("No video DMA found for ID %d\r\n", VDMA_ID);
		return;
	}
	Status = XAxiVdma_CfgInitialize(&vdma, vdmaConfig, vdmaConfig->BaseAddress);
	if (Status != XST_SUCCESS)
	{
		xil_printf("VDMA Configuration Initialization failed %d\r\n", Status);
		return;
	}

	// Display controller initialize and start
	Status = DisplayInitialize(&dispCtrl, &vdma, HDMI_OUT_VTC_ID,
							 	 DYNCLK_BASEADDR, pFrames, DEMO_STRIDE);

	if (Status != XST_SUCCESS)
	{
		xil_printf("Display Ctrl initialization failed during driver initialization%d\r\n", Status);
		return;
	}

	Status = DisplayStart(&dispCtrl);  // start output display
	if (Status != XST_SUCCESS)
	{
		xil_printf("Couldn't start display during driver initialization%d\r\n", Status);
		return;
	}

	// Initialize Interrupts
	Status = fnInitInterruptController(&intc);
	if(Status != XST_SUCCESS) {
		xil_printf("Error initializing interrupts");
		return;
	}
	fnEnableInterrupts(&intc, &ivt[0], sizeof(ivt)/sizeof(ivt[0]));

	// Todo: Initialize FPGA Solver
	SolverInitialize();

	// Draw initial test pattern
	ClearFramebuffer(pFrames[dispCtrl.curFrame], dispCtrl.vMode.width,
					 dispCtrl.vMode.height, DEMO_STRIDE);
}


/* ========== FPGA Solver Interface Functions ========== */
void SolverInitialize()
{
    // Write initial parameters to FPGA
    volatile int *sigma_reg = (int *)REG_SOLVER_SIGMA;
    volatile int *beta_reg = (int *)REG_SOLVER_BETA;
    volatile int *rho_reg = (int *)REG_SOLVER_RHO;
    volatile int *control_reg = (int *)REG_SOLVER_CONTROL;

    // Convert float to fixed-point (7.20 format)
    // sigma = 10.0 ↙ 0x00000A00
    *sigma_reg = FloatToFixed(10.0);
    *beta_reg = FloatToFixed(8.33);
    *rho_reg = FloatToFixed(28.0);

    // Enable solver
    *control_reg = SOLVER_ENABLE;

    xil_printf("FPGA Solver initialized\r\n");
}

// Convert float to 7.20 fixed-point
int FloatToFixed(float val)
{
    return (int)(val * (1 << 20));  // Multiply by 2^20 for fractional bits
}

// Read solver output
void ReadSolverOutput(int *x, int *y, int *z)
{
    volatile int *x_reg = (int *)REG_SOLVER_X;
    volatile int *y_reg = (int *)REG_SOLVER_Y;
    volatile int *z_reg = (int *)REG_SOLVER_Z;

    *x = *x_reg;
    *y = *y_reg;
    *z = *z_reg;
}

// Plot Lorenz points to framebuffer
void PlotLorenzAttractor(u8 *frame, u32 width, u32 height, u32 stride)
{
    int solver_x, solver_y, solver_z;
    int screen_x, screen_y;
    u32 pixel_addr;
    u16 color = 0xFFFF;  // color white

    // Continuously plot solver output
    for(int iter = 0; iter < 100; iter++)  // Plot 100 points per frame
    {
        // Read current solver state from FPGA
        ReadSolverOutput(&solver_x, &solver_y, &solver_z);

        // Convert fixed-point (7.20) to screen coordinates
        // Assume solver output in range -64 to +64
        // Map to screen: 0 to width, 0 to height

        int fixed_x = solver_x >> 20;  // Extract integer part
        int fixed_y = solver_y >> 20;

        // Map to screen (center at middle)
        screen_x = (fixed_x + 64) * width / 128;    // Map -64..+64 to 0..width
        screen_y = (fixed_y + 64) * height / 128;   // Map -64..+64 to 0..height

        // Clamp to screen bounds
        if (screen_x >= 0 && screen_x < width &&
            screen_y >= 0 && screen_y < height)
        {
            // Plot pixel in 16-bit format (2 bytes per pixel)
            pixel_addr = (screen_y * stride) + (screen_x * 2);

            // Write 16-bit color
            frame[pixel_addr] = (u8)(color & 0xFF);
            frame[pixel_addr + 1] = (u8)((color >> 8) & 0xFF);
        }

        // Small delay to let solver update
        TimerDelay(100);
    }

    // Flush cache to ensure display sees updated pixels
    Xil_DCacheFlushRange((unsigned int)frame, DEMO_MAX_FRAME);
}

void ClearFramebuffer(u8 *frame, u32 width, u32 height, u32 stride)
{
    u32 i;
    // Clear to black
    for (i = 0; i < DEMO_MAX_FRAME; i++)
    {
        frame[i] = 0x00;
    }
    Xil_DCacheFlushRange((unsigned int)frame, DEMO_MAX_FRAME);
}

void DriverRun()
{
	int nextFrame = 0;
	char userInput = 0;

	/* Flush UART FIFO */
	while (XUartPs_IsReceiveData(UART_BASEADDR))
	{
		XUartPs_ReadReg(UART_BASEADDR, XUARTPS_FIFO_OFFSET);
	}

	while (userInput != 'q')
	{
		DriverPrintMenu();

		/* Wait for data on UART */
		while (!XUartPs_IsReceiveData(UART_BASEADDR) && !fRefresh)
		{}

		/* Store the first character in the UART receive FIFO and echo it */
		if (XUartPs_IsReceiveData(UART_BASEADDR))
		{
			userInput = XUartPs_ReadReg(UART_BASEADDR, XUARTPS_FIFO_OFFSET);
			xil_printf("%c", userInput);
		}
		else  //Refresh triggered by video detect interrupt
		{
			userInput = 'r';
		}

		switch (userInput)
		{
		case '1':
			// Plot Lorenz attractor
			PlotLorenzAttractor(pFrames[dispCtrl.curFrame],
							   dispCtrl.vMode.width,
							   dispCtrl.vMode.height,
							   DEMO_STRIDE);
			break;

		case '2':
			// Clear screen
			ClearFramebuffer(pFrames[dispCtrl.curFrame],
							dispCtrl.vMode.width,
							dispCtrl.vMode.height,
							DEMO_STRIDE);
			xil_printf("Screen cleared\r\n");
			break;

		case '3':
			// Toggle solver enable
			lorenz_config.solver_enabled = !lorenz_config.solver_enabled;
			if (lorenz_config.solver_enabled)
			{
				*control_reg |= SOLVER_ENABLE;
				xil_printf("Solver ENABLED\r\n");
			}
			else
			{
				*control_reg &= ~SOLVER_ENABLE;
				xil_printf("Solver PAUSED\r\n");
			}
			break;

		case '4':
			// Reset solver
			*control_reg |= SOLVER_RESET;
			TimerDelay(100);
			*control_reg &= ~SOLVER_RESET;
			xil_printf("Solver RESET\r\n");
			break;

		case '5':
			// Change parameters
			DriverChangeParameters();
			break;

		case '6':
			// Change resolution
			DriverChangeRes();
			break;

		case 'q':
            // Quit
            *control_reg &= ~SOLVER_ENABLE;  // Disable solver
            xil_printf("\r\nExiting...\r\n");
            break;

        default:
            xil_printf("Invalid selection\r\n");
            TimerDelay(500000);
        }
	}

	return;
}

