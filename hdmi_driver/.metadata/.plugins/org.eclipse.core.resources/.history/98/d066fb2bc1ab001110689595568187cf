/* ========== Parameter Change Menu ========== */

void DriverChangeParameters()
{
    char userInput = 0;
    float newValue;
    volatile int *sigma_reg = (int *)REG_SOLVER_SIGMA;
    volatile int *beta_reg = (int *)REG_SOLVER_BETA;
    volatile int *rho_reg = (int *)REG_SOLVER_RHO;

    int paramSet = 0;

    while (!paramSet)
    {
        xil_printf("\x1B[H");
        xil_printf("\x1B[2J");
        xil_printf("***** Change Lorenz Parameters *****\n\r");
        xil_printf("1 - Change 考 (sigma)   [Current: %.2f]\n\r", lorenz_config.sigma);
        xil_printf("2 - Change 汕 (beta)    [Current: %.2f]\n\r", lorenz_config.beta);
        xil_printf("3 - Change 老 (rho)     [Current: %.2f]\n\r", lorenz_config.rho);
        xil_printf("q - Done\n\r");
        xil_printf("\n\rSelect: ");

        // Wait for input
        while (!XUartPs_IsReceiveData(UART_BASEADDR))
        {}

        userInput = XUartPs_ReadReg(UART_BASEADDR, XUARTPS_FIFO_OFFSET);
        xil_printf("%c\n\r", userInput);

        switch (userInput)
        {
        case '1':
            xil_printf("Enter new 考 value (float): ");
            newValue = ReadFloatFromUART();
            lorenz_config.sigma = newValue;
            *sigma_reg = FloatToFixed(newValue);
            xil_printf("考 set to %.2f\n\r", newValue);
            TimerDelay(500000);
            break;

        case '2':
            xil_printf("Enter new 汕 value (float): ");
            newValue = ReadFloatFromUART();
            lorenz_config.beta = newValue;
            *beta_reg = FloatToFixed(newValue);
            xil_printf("汕 set to %.2f\n\r", newValue);
            TimerDelay(500000);
            break;

        case '3':
            xil_printf("Enter new 老 value (float): ");
            newValue = ReadFloatFromUART();
            lorenz_config.rho = newValue;
            *rho_reg = FloatToFixed(newValue);
            xil_printf("老 set to %.2f\n\r", newValue);
            TimerDelay(500000);
            break;

        case 'q':
            paramSet = 1;
            break;

        default:
            xil_printf("Invalid selection\n\r");
            TimerDelay(500000);
        }
    }
}

/* ========== UART Input Helper ========== */

float ReadFloatFromUART()
{
    char buffer[32] = {0};
    int idx = 0;
    char ch;

    while (idx < 31)
    {
        // Wait for character
        while (!XUartPs_IsReceiveData(UART_BASEADDR))
        {}

        ch = XUartPs_ReadReg(UART_BASEADDR, XUARTPS_FIFO_OFFSET);

        if (ch == '\r' || ch == '\n')
        {
            xil_printf("\n\r");
            break;
        }
        else if (ch == '\b' && idx > 0)  // Backspace
        {
            idx--;
            xil_printf("%c", ch);
        }
        else if ((ch >= '0' && ch <= '9') || ch == '.' || ch == '-')
        {
            buffer[idx++] = ch;
            xil_printf("%c", ch);
        }
    }

    buffer[idx] = '\0';
    return (float)atof(buffer);
}

void DriverChangeRes()
{
	int fResSet = 0;
	int status;
	char userInput = 0;

	/* Flush UART FIFO */
	while (XUartPs_IsReceiveData(UART_BASEADDR))
	{
		XUartPs_ReadReg(UART_BASEADDR, XUARTPS_FIFO_OFFSET);
	}

	while (!fResSet)
	{
		DriverCRMenu();

		/* Wait for data on UART */
		while (!XUartPs_IsReceiveData(UART_BASEADDR))
		{}

		/* Store the first character in the UART recieve FIFO and echo it */
		userInput = XUartPs_ReadReg(UART_BASEADDR, XUARTPS_FIFO_OFFSET);
		xil_printf("%c", userInput);
		status = XST_SUCCESS;

		switch (userInput)
		{
		case '1':
			status = DisplayStop(&dispCtrl);
			DisplaySetMode(&dispCtrl, &VMODE_640x480);
			DisplayStart(&dispCtrl);
			fResSet = 1;
			break;
		case '2':
			status = DisplayStop(&dispCtrl);
			DisplaySetMode(&dispCtrl, &VMODE_800x600);
			DisplayStart(&dispCtrl);
			fResSet = 1;
			break;
		case '3':
			status = DisplayStop(&dispCtrl);
			DisplaySetMode(&dispCtrl, &VMODE_1280x720);
			DisplayStart(&dispCtrl);
			fResSet = 1;
			break;
		case 'q':
			fResSet = 1;
			break;
		default :
			xil_printf("\n\rInvalid Selection");
			TimerDelay(500000);
		}
		if (status == XST_DMA_ERROR)
		{
			xil_printf("\n\rWARNING: AXI VDMA Error detected and cleared\n\r");
		}
	}
}

