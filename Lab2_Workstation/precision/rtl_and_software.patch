diff --git a/Lab2_Workstation/Mandelbrot_workspace_workstation/Zybo-Z7-10-HDMI/src/mandel/mandel.c b/Lab2_Workstation/Mandelbrot_workspace_workstation/Zybo-Z7-10-HDMI/src/mandel/mandel.c
